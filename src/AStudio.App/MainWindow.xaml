<Window
    x:Class="AStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AStudio">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="AStudio" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Accelerated Studio — architecture desktop (D5 shell)"
                       Opacity="0.7"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="Hub bridge" FontWeight="SemiBold"/>
                <TextBlock x:Name="HubStatusText" TextWrapping="Wrap"/>
                <TextBlock x:Name="LogText" Opacity="0.7" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="LicenseKeyBox" Width="280" PlaceholderText="License key (HLP-…)"
                     Header="Activate"/>
            <Button Content="Activate" Click="Activate_Click" VerticalAlignment="Bottom"/>
            <Button Content="Enqueue smoke meta" Click="Enqueue_Click" VerticalAlignment="Bottom"/>
            <Button Content="Flush" Click="Flush_Click" VerticalAlignment="Bottom"/>
            <Button Content="Refresh status" Click="Refresh_Click" VerticalAlignment="Bottom"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Engine + domain UI come next. This shell proves WinUI + Aorms.Bridge ProjectReference on this machine."
                   Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
