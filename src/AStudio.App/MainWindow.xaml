<Window
    x:Class="AStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AStudio">

    <!--
      HCW geography · S2c:
      Ribbon (Focus · Portfolio · Practice · Tasks) · Stage modules · ActionDock · sync tray.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECEEF2" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="AStudio" FontSize="18" FontWeight="SemiBold" Foreground="#141517"/>
                    <TextBlock Text="Accelerated Studio" Opacity="0.65" VerticalAlignment="Center" Foreground="#141517"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavFocusBtn" Content="Focus" Click="NavFocus_Click"/>
                    <Button x:Name="NavPortfolioBtn" Content="Portfolio" Click="NavPortfolio_Click"/>
                    <Button x:Name="NavPracticeBtn" Content="Practice" Click="NavPractice_Click"/>
                    <Button x:Name="NavTasksBtn" Content="Tasks" Click="NavTasks_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Local AI · desktop" Opacity="0.55"
                           VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Background="#F2F4F7" Padding="24">
            <Grid MaxWidth="960" HorizontalAlignment="Left">

                <StackPanel x:Name="PanelPortfolio" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Portfolio" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Practice projects in firm.db. Select one to Focus; publish status meta to the hub."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AORMS Connect" FontWeight="SemiBold"/>
                            <TextBlock Text="Pull projects from Connect’s shared catalog into this firm.db."
                                       Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportConnectBtn" Content="Import from Connect"
                                        Click="ImportCatalog_Click" MinHeight="44" MinWidth="180"/>
                            </StackPanel>
                            <TextBlock x:Name="CatalogImportNote" TextWrapping="Wrap" FontSize="12"
                                       Opacity="0.75"
                                       Text="No import yet — run AORMS Connect, then Import from Connect here or on the dock."/>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="New project" FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectTitleBox" Header="Title" PlaceholderText="Residence · Hospet"/>
                            <TextBox x:Name="ProjectRefBox" Header="Ref" PlaceholderText="AST-2026-001"/>
                            <TextBox x:Name="ProjectPhaseBox" Header="Phase" PlaceholderText="Concept / DD / Tender"/>
                            <TextBlock Text="Local projects" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ProjectListText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Content="Open selected in Focus" Click="OpenSelectedFocus_Click"
                                    MinHeight="44"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelFocus" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Focus" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock x:Name="FocusSubtitle" Text="No project in focus."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="FocusEmptyPanel" Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1" Visibility="Visible">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No project selected"
                                       FontWeight="SemiBold" Foreground="#141517"/>
                            <TextBlock x:Name="FocusEmptyCopy"
                                       Text="Open Portfolio, pick a local project (or Import from Connect), then Open selected in Focus. Save focus writes the brief; Publish status queues projectStatus meta to the hub."
                                       Opacity="0.7" TextWrapping="Wrap"/>
                            <Button Content="Go to Portfolio" Click="NavPortfolio_Click"
                                    MinHeight="44" MinWidth="140"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FocusBriefPanel" Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="FocusTitleBox" Header="Title"/>
                            <TextBox x:Name="FocusRefBox" Header="Ref"/>
                            <TextBox x:Name="FocusStatusBox" Header="Status" PlaceholderText="ACTIVE / HOLD / CLOSED"/>
                            <TextBox x:Name="FocusPhaseBox" Header="Phase"/>
                            <TextBox x:Name="FocusNotesBox" Header="Brief / notes" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="80"/>
                            <TextBlock x:Name="FocusMetaText" FontFamily="Consolas" FontSize="12"
                                       Opacity="0.7" TextWrapping="Wrap"/>
                            <TextBlock Text="Dock: Save focus keeps the brief local · Publish status (orange) sends projectStatus meta. Estimate · BBS via bbs_engine lands in S2d."
                                       Opacity="0.55" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelPractice" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Practice" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Office health placeholder. Hub activate / flush also available in the sync tray."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <TextBlock Text="KPIs and attention queue land with Studio Intelligence (S3)."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelTasks" Spacing="16" Visibility="Visible">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tasks" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Local firm.db → publish to Mongo ops."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Task board" FontWeight="SemiBold"/>
                            <TextBox x:Name="TaskTitleBox" Header="Title" PlaceholderText="Task title"/>
                            <TextBox x:Name="TaskProjectBox" Header="Project id"
                                     PlaceholderText="Uses Focus project when set"/>
                            <TextBlock x:Name="TaskListText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ActionDock ≤5: destroy LEFT · create CENTRE · commit RIGHT (one orange Publish) -->
        <Border Grid.Row="2" Background="#ECEEF2" Padding="16,8" BorderBrush="#D0D4DC" BorderThickness="0,1,0,0">
            <Grid MaxWidth="960" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Clear form" Click="ClearForm_Click" MinHeight="44"/>
                    <Button x:Name="DockImportBtn" Content="Import from Connect"
                            Click="ImportCatalog_Click" MinHeight="44" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DockCreateBtn" Content="Save local" Click="DockCreate_Click"
                            MinHeight="44" MinWidth="120"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DockReloadBtn" Content="Reload" Click="DockReload_Click" MinHeight="44"/>
                    <Button x:Name="DockCommitBtn" Content="Publish to hub" Click="DockCommit_Click"
                            Background="#FF4F18" Foreground="White" MinHeight="44" MinWidth="140"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#ECEEF2" Padding="16,8" BorderBrush="#D0D4DC" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TrayText" Text="AStudio · S2c Portfolio"
                           FontSize="11" Opacity="0.55"/>
                <TextBlock x:Name="HubStatusText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="LogText" Opacity="0.7" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="LicenseKeyBox" Width="280"
                             PlaceholderText="License key (HLP-…)" Header="Activate"/>
                    <Button Content="Activate" Click="Activate_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Flush meta" Click="Flush_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
