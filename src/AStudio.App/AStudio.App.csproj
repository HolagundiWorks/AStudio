<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AStudio.App</RootNamespace>
    <AssemblyName>AStudio</AssemblyName>
    <ApplicationTitle>AStudio</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Company>Human Centric Works</Company>
    <Product>AStudio</Product>
    <Authors>Human Centric Works, Hospet</Authors>
    <Description>AStudio (Accelerated Studio) — architecture desktop OS on AQC engine + Aorms.Bridge.</Description>
    <Copyright>Copyright © 2026 Human Centric Works, Hospet</Copyright>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged for D5 shell smoke; MSIX signing deferred to D6. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\AQC\BBSDesktop\Aorms.Bridge\Aorms.Bridge.csproj" />
  </ItemGroup>

  <!-- S2d: copy pinned AQC bbs_engine.dll beside AStudio.exe when built (see build-engine.cmd). -->
  <ItemGroup>
    <Content Include="..\..\vendor\AQC\BBSDesktop\build\bbs_engine.dll"
             Condition="Exists('..\..\vendor\AQC\BBSDesktop\build\bbs_engine.dll')">
      <Link>bbs_engine.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyEngineDll" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_EngineDll>$(MSBuildThisFileDirectory)..\..\vendor\AQC\BBSDesktop\build\bbs_engine.dll</_EngineDll>
      <_EngineDest Condition="'$(PublishDir)' != ''">$(PublishDir)</_EngineDest>
      <_EngineDest Condition="'$(PublishDir)' == ''">$(OutputPath)</_EngineDest>
    </PropertyGroup>
    <Copy SourceFiles="$(_EngineDll)" DestinationFolder="$(_EngineDest)" SkipUnchangedFiles="true"
          Condition="Exists('$(_EngineDll)')" />
  </Target>
</Project>
